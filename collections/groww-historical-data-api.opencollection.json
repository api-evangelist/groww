{
  "opencollection": "1.0.0",
  "info": {
    "name": "Groww Trading Authentication Historical Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Historical Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get historical candle data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.groww.in/v1/historical/candle/range",
            "params": [
              {
                "name": "exchange",
                "value": "",
                "type": "query"
              },
              {
                "name": "segment",
                "value": "",
                "type": "query"
              },
              {
                "name": "trading_symbol",
                "value": "",
                "type": "query"
              },
              {
                "name": "start_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "end_time",
                "value": "",
                "type": "query"
              },
              {
                "name": "interval_in_minutes",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve historical OHLC candles for a symbol over a time range. Deprecated in favour of the backtesting historical candle endpoint."
        }
      ]
    }
  ],
  "bundled": true
}