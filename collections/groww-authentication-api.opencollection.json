{
  "opencollection": "1.0.0",
  "info": {
    "name": "Groww Trading Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.groww.in/v1/token/api/access",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Exchange an API key (sent as the bearer credential) plus either an approval checksum or a TOTP code for a short-lived access token used on all subsequent requests. Access tokens expire daily at 06:00 AM IST."
        }
      ]
    }
  ],
  "bundled": true
}